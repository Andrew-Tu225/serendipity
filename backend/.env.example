# Copy to backend/.env and fill in. Never commit backend/.env.
DEBUG=false

# Server-only Google key. Restrict to Places API (New), and server IPs where available.
BACKEND_API_KEY_GOOGLE=

# Docker development database. These credentials are for local development only.
POSTGRES_DB=serendipity
POSTGRES_USER=serendipity
POSTGRES_PASSWORD=serendipity_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://serendipity:serendipity_dev@127.0.0.1:5433/serendipity
# db:seed/db:clear use DATABASE_URL and reject non-loopback hosts. Clear also requires --confirm DB_NAME.

# Public frontend origin. Auth0 callbacks also go through its /api proxy.
APP_BASE_URL=http://localhost:3000
PORT=3000

# Auth0 Regular Web Application; all values stay on the backend.
# Domain is the tenant hostname, e.g. dev-example.us.auth0.com.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Use true with HTTPS in production. False is allowed only on localhost.
COOKIE_SECURE=false
SESSION_COOKIE_NAME=serendipity_session
SESSION_LIFETIME_SECONDS=28800
LOGIN_LIFETIME_SECONDS=600
