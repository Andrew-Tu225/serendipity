# Copy to .env.local and fill in. Prefix with NEXT_PUBLIC_ only for values safe to expose to the browser.

# Base URL of the FastAPI backend that /api/* is proxied to. Server-only.
API_URL=http://127.0.0.1:8000

# Optional: dedicated Next.js output directory for isolated builds/tests.
# SERENDIPITY_DIST_DIR=.next-auth-build
